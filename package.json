{
  "name": "durastep",
  "version": "0.1.0",
  "description": "Durable, idempotent multi-step agent pipelines on your own Postgres and Redis. A library, not a platform.",
  "license": "MIT",
  "author": "Mert Seker <meertseker@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meertseker/durastep.git"
  },
  "homepage": "https://github.com/meertseker/durastep#readme",
  "bugs": {
    "url": "https://github.com/meertseker/durastep/issues"
  },
  "keywords": [
    "workflow",
    "dag",
    "pipeline",
    "agents",
    "llm",
    "idempotency",
    "bullmq",
    "postgres",
    "durable",
    "orchestration"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./postgres": {
      "import": {
        "types": "./dist/postgres/index.d.ts",
        "default": "./dist/postgres/index.js"
      },
      "require": {
        "types": "./dist/postgres/index.d.cts",
        "default": "./dist/postgres/index.cjs"
      }
    },
    "./postgres/schema.sql": "./dist/postgres/schema.sql",
    "./bullmq": {
      "import": {
        "types": "./dist/bullmq/index.d.ts",
        "default": "./dist/bullmq/index.js"
      },
      "require": {
        "types": "./dist/bullmq/index.d.cts",
        "default": "./dist/bullmq/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "tsx examples/basic/index.ts",
    "example:bullmq": "tsx examples/bullmq/index.ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "bullmq": "^5.0.0",
    "ioredis": "^5.0.0",
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "bullmq": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "bullmq": "6.4.0",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
